# KuCoin Futures Trading Bot Configuration
# Copy this file to .env and configure your settings

# =============================================================================
# MODE
# =============================================================================
# Options: 'live' | 'paper' | 'backtest'
# - live: Real trading with real money (requires API credentials)
# - paper: Simulated trading with live market data
# - backtest: Historical data testing
MODE=paper

# =============================================================================
# API CREDENTIALS (Required for 'live' mode, optional for 'paper')
# =============================================================================
# Get your API keys from: https://www.kucoin.com/account/api
# IMPORTANT: For live trading, enable futures trading permission
# RECOMMENDED: Use IP allowlist for security
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=

# =============================================================================
# TRADING SYMBOLS
# =============================================================================
# Comma-separated list of KuCoin Futures perpetual contracts
# Format: {BASE}USDTM (e.g., XBTUSDTM, ETHUSDTM)
SYMBOLS=XBTUSDTM,ETHUSDTM

# =============================================================================
# TIMEFRAMES
# =============================================================================
# Primary timeframe for signal generation
# Options: 1min, 5min, 15min, 30min, 1hour, 4hour, 1day
PRIMARY_TF=5min

# Secondary timeframe for confirmation
# Should be higher than primary
SECONDARY_TF=15min

# =============================================================================
# RISK MANAGEMENT
# =============================================================================
# Leverage (1-100, subject to exchange limits per symbol)
LEVERAGE=5

# Risk per trade as percentage of balance (1-10 recommended)
RISK_PERCENT=2

# Maximum concurrent open positions
MAX_POSITIONS=3

# Signal threshold for entry (-130 to +130)
# Higher = more selective, fewer trades
# Lower = more trades, potentially lower quality
SIGNAL_THRESHOLD=50

# =============================================================================
# STOP LOSS / TAKE PROFIT (ROI-based)
# =============================================================================
# Stop loss as ROI percentage (e.g., 3 = 3% ROI loss triggers stop)
# Actual price movement depends on leverage: price_move = ROI / leverage
SL_ROI=3

# Take profit as ROI percentage
TP_ROI=6

# Enable trailing stop loss (true/false)
TRAILING=true

# Trailing stop activation threshold (ROI %)
# Stop only starts trailing after this profit is reached
TRAILING_ACTIVATION=2

# Trailing stop distance (ROI %)
TRAILING_DISTANCE=1

# =============================================================================
# PAPER TRADING
# =============================================================================
# Starting balance for paper trading simulation
PAPER_BALANCE=10000

# =============================================================================
# MICROSTRUCTURE FILTERS (Live mode only)
# =============================================================================
# Maximum bid/ask spread to allow entry (percentage)
MAX_SPREAD=0.03

# Maximum absolute funding rate to allow entry (percentage)
MAX_FUNDING=0.02

# =============================================================================
# SERVER
# =============================================================================
# Dashboard port
PORT=3000

# Enable debug logging
DEBUG=false

# =============================================================================
# ADVANCED: INDICATOR PARAMETERS
# =============================================================================
# RSI settings
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# MACD settings
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Bollinger Bands settings
BB_PERIOD=20
BB_STDDEV=2

# Stochastic settings
STOCH_K_PERIOD=14
STOCH_D_PERIOD=3
STOCH_OVERSOLD=20
STOCH_OVERBOUGHT=80

# KDJ settings
KDJ_K_PERIOD=9
KDJ_J_OVERSOLD=20
KDJ_J_OVERBOUGHT=80

# Williams %R settings
WILLIAMS_PERIOD=14
WILLIAMS_OVERSOLD=-80
WILLIAMS_OVERBOUGHT=-20

# ATR settings (for volatility)
ATR_PERIOD=14
